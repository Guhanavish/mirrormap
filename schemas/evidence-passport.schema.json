{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Guhanavish/mirrormap/blob/main/schemas/evidence-passport.schema.json",
  "title": "Evidence passports",
  "description": "Local, informational MirrorMap artifact. Does not grant execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "records",
    "authority",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "authority": {
      "const": "informational_only"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_id",
          "classification",
          "evidence",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,160}$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,160}$"
          },
          "classification": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
