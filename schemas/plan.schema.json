{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Guhanavish/project-mirror/blob/main/schemas/plan.schema.json",
  "title": "ProjectMirror proposed plan",
  "description": "A plan is never a grant of authorization.",
  "type": "object",
  "required": ["schema_version", "base_revision", "environment", "tasks", "plan_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "base_revision": {"type": ["string", "null"]},
    "environment": {"type": "string"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "finding_id", "type", "allowed_paths", "approval_required"],
        "properties": {
          "task_id": {"type": "string"},
          "finding_id": {"type": "string"},
          "type": {"enum": ["investigate", "remediate"]},
          "classification": {"type": "string"},
          "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "approval_required": {"const": true}
        }
      }
    }
  }
}
